{
  "name": "placehive-backend",
  "version": "1.0.0",
  "description": "Backend API for PlaceHive - Relocation Support Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:clean": "npm run kill-port && npm run dev",
    "kill-port": "npx kill-port 6000",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "seed": "node src/scripts/seed-all.js",
    "seed:users": "node src/scripts/seed-users.js",
    "seed:accommodations": "node src/scripts/seed-accommodations.js",
    "seed:meal-providers": "node src/scripts/seed-meal-providers.js",
    "seed:transport": "node src/scripts/seed-transport.js",
    "seed:expenses": "node src/scripts/seed-expenses.js",
    "seed:bookmarks": "node src/scripts/seed-bookmarks.js",
    "seed:reviews": "node src/scripts/seed-reviews.js"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "relocation",
    "accommodation",
    "expense-tracking",
    "meal-rating",
    "transport"
  ],
  "author": "PlaceHive Team",
  "license": "MIT"
}
